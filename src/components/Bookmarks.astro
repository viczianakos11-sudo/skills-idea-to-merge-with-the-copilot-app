<section class="bookmark-app" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
        aria-describedby="url-hint"
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p id="url-hint" class="hint">Paste a URL with or without <code>https://</code> to make a short <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style>
  .bookmark-app {
    padding: clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(ellipse at top right, color-mix(in srgb, var(--accent) 10%, transparent), transparent 52%),
      color-mix(in srgb, currentColor 2%, transparent);
    box-shadow: 0 1rem 3rem color-mix(in srgb, currentColor 6%, transparent);
  }

  .bookmark-app form { margin-top: 0; }
  .bookmark-app input { min-width: 0; transition: border-color 150ms ease, box-shadow 150ms ease; }
  .bookmark-app input:focus-visible { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .bookmark-app form button { white-space: nowrap; }
  .bookmark-app form button span { padding-left: 0.35rem; }
  .hint { margin-bottom: 1rem; }
  .status { min-height: 1.5em; margin: 0 0 0.75rem; color: var(--muted); font-size: 0.85rem; }
  .status[data-error="true"] { color: #d14b4b; }
  .bookmark-app #list-header { margin-top: 1rem; }
  .bookmark-app ul { gap: 0.65rem; }
  .bookmark-app li.bookmark { background: color-mix(in srgb, currentColor 2%, transparent); }
  .bookmark-label { min-width: 0; overflow-wrap: anywhere; }
  .bookmark .url { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 0.2em; }
  .bookmark .separator { white-space: pre; color: var(--muted); }
  .bookmark .slug { font-family: var(--font-body); font-weight: 600; }
  .bookmark .copy { margin-left: auto; }

  @media (max-width: 34rem) {
    .bookmark-app form button { width: 100%; }
  }
</style>

<script>
  import { loadBookmarks, normalizeUrl, STORAGE_KEY } from '../lib/bookmarks.mjs';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  let bookmarks = [];

  function setStatus(message, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.dataset.error = String(isError);
  }

  function persistBookmarks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      return true;
    } catch (error) {
      console.error('Could not save bookmarks to local storage.', error);
      return false;
    }
  }

  function makeSlug() {
    const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    const bytes = new Uint8Array(4);
    let slug;
    do {
      crypto.getRandomValues(bytes);
      slug = `mona-${Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
    } while (bookmarks.some((bookmark) => bookmark.slug === slug));
    return slug;
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const label = document.createElement('span');
      label.className = 'bookmark-label';
      label.append(link, separator, slug);

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug}.`);
        } catch (error) {
          console.error('Could not copy bookmark slug.', error);
          setStatus('Could not copy the slug. Check clipboard permissions.', true);
        }
      });

      item.append(label, copy);
      list.append(item);
    }
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      if (!input) throw new Error('The bookmark URL field is unavailable.');
      const url = normalizeUrl(input.value);
      if (bookmarks.some((bookmark) => bookmark.url === url)) {
        setStatus('That URL is already saved.', true);
        return;
      }
      bookmarks = [...bookmarks, { url, slug: makeSlug() }];
      const saved = persistBookmarks();
      renderBookmarks();
      input.value = '';
      setStatus(saved ? 'Bookmark saved.' : 'Bookmark added for this session, but could not be saved on this device.', !saved);
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Please enter a valid web URL.', true);
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    const saved = persistBookmarks();
    renderBookmarks();
    setStatus(saved ? 'All bookmarks cleared.' : 'Bookmarks cleared for this session, but stored data could not be updated.', !saved);
  });

  try {
    bookmarks = loadBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch (error) {
    console.error('Could not load bookmarks from local storage.', error);
    bookmarks = [];
  }
  renderBookmarks();
</script>
